name: Deploy production ({{productionEnv}})

# Push em {{productionBranch}} publica no ambiente {{productionEnv}} (S3 + CloudFront). Autenticacao por OIDC, sem chaves.
# Exige as variables AWS_ROLE_ARN e AWS_REGION e a stack {{clientId}}-{{productionEnvSlug}} ja criada (ver infra/README.md).
on:
  push:
    branches: [{{productionBranch}}]
  workflow_dispatch:

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    name: Deploy to {{productionEnv}}
    runs-on: ubuntu-latest
    environment: {{productionEnv}}
    defaults:
      run:
        working-directory: {{projectDir}}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: '{{projectDir}}/.nvmrc'
          cache: npm
          cache-dependency-path: '{{projectDir}}/package-lock.json'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}

      - name: Resolve stack outputs
        id: stack
        run: |
          STACK="{{clientId}}-{{productionEnvSlug}}"
          output() {
            aws cloudformation describe-stacks --stack-name "$STACK" \
              --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue" --output text
          }
          echo "bucket=$(output BucketName)" >> "$GITHUB_OUTPUT"
          echo "distribution=$(output DistributionId)" >> "$GITHUB_OUTPUT"

      - name: Upload bundles com hash (cache longo)
        run: |
          aws s3 sync "{{outputDir}}" "s3://${{ steps.stack.outputs.bucket }}" \
            --exclude "*" --include "*.js" --include "*.css" \
            --cache-control "public,max-age=31536000,immutable"

      - name: Upload demais arquivos (revalida sempre) e remove os que sairam do build
        run: |
          aws s3 sync "{{outputDir}}" "s3://${{ steps.stack.outputs.bucket }}" \
            --delete --exclude "*.js" --exclude "*.css" \
            --cache-control "public,max-age=0,must-revalidate"

      - name: Invalidar cache do CloudFront
        run: |
          aws cloudfront create-invalidation \
            --distribution-id "${{ steps.stack.outputs.distribution }}" --paths "/*"
