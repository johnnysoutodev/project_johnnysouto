name: Deploy production ({{productionEnv}})

# Push em {{productionBranch}} (ou execucao manual) audita dependencias e publica em producao.
# O Environment {{productionEnv}} deve ter Required reviewers para a aprovacao manual.
on:
  push:
    branches: [{{productionBranch}}]
  workflow_dispatch:

jobs:
  security-audit:
    name: Security audit
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{projectDir}}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: '{{projectDir}}/.nvmrc'
          cache: npm
          cache-dependency-path: '{{projectDir}}/package-lock.json'

      - name: Install dependencies
        run: npm ci

      - name: Audit (bloqueia apenas vulnerabilidades criticas)
        run: npm audit --audit-level=critical

  deploy:
    name: Deploy to {{productionEnv}}
    runs-on: ubuntu-latest
    needs: security-audit
    environment:
      name: {{productionEnv}}
      {{productionEnvUrlLine}}
    defaults:
      run:
        working-directory: {{projectDir}}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: '{{projectDir}}/.nvmrc'

      - name: Install Vercel CLI
        run: npm install --global vercel@latest

      - name: Deploy to Vercel (production)
        id: deploy
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
        run: |
          URL=$(vercel deploy --prod --token="$VERCEL_TOKEN" --yes)
          echo "url=$URL" >> "$GITHUB_OUTPUT"
          echo "Production URL: $URL"
