{
  "name": "project_johnnysouto",
  "version": "2.2.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration en-US",
    "start:es": "ng serve --configuration es",
    "serve:i18n": "ng build && node scripts/serve-i18n.mjs",
    "serve:i18n:only": "node scripts/serve-i18n.mjs",
    "extract-i18n": "ng extract-i18n --format json --output-path src/locale",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,js,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,js,md}\""
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8"
  }
}
